# 环境配置
ENVIRONMENT=dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DECODE_RESPONSES=true
REDIS_SSL=false

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Dorm electricity query (set the actual campus payment site root URL)
ELECTRICITY_BASE_URL=
ELECTRICITY_ACCOUNTS_FILE=./config/electricity_accounts.json
