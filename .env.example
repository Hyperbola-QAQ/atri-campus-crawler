# 环境配置
ENVIRONMENT=dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DECODE_RESPONSES=true
REDIS_SSL=false
REDIS_SOCKET_CONNECT_TIMEOUT=1
REDIS_SOCKET_TIMEOUT=1
REDIS_RETRY_INTERVAL_SECONDS=30
ELECTRICITY_CACHE_KEY_PREFIX=electricity:daily
ELECTRICITY_CACHE_TIMEZONE=Asia/Shanghai

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Dorm electricity query account pool
ELECTRICITY_ACCOUNTS_FILE=./config/electricity_accounts.json
ELECTRICITY_ROOM_CATALOG_FILE=./config/electricity_rooms.json
ELECTRICITY_COLLECTION_STATE_FILE=./config/electricity_collection_state.json
ELECTRICITY_SCHEDULE_TIMEZONE=Asia/Shanghai

# Academic affairs query accounts. This is separate from the electricity pool.
ACADEMIC_ACCOUNTS_FILE=./config/academic_accounts.json
